		"jiti": "2.6.1",
		"stylelint": "^17.12.0",
		"stylelint-no-unsupported-browser-features": "^8.1.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
